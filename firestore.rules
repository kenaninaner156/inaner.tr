rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Yardımcı Fonksiyonlar
    
    // Kullanıcının giriş yapıp yapmadığını kontrol eder
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Giriş yapan kullanıcının onaylı (approved) olup olmadığını kontrol eder ve onaylı kullanıcı dökümanını döner
    function getApprovedUser() {
      return get(/databases/$(database)/documents/approved_users/$(request.auth.uid)).data;
    }
    
    // Kullanıcının onaylı bir üye olup olmadığını doğrular
    function isApproved() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/approved_users/$(request.auth.uid)) ||
        request.auth.token.email == 'kenan@inaner.com'
      );
    }
    
    // Kullanıcının şirket ID'sini alır
    function getCompanyId() {
      return getApprovedUser().companyId;
    }
    
    // Kullanıcının rolünü alır
    function getUserRole() {
      return getApprovedUser().role;
    }
    
    // Kullanıcının Super Admin olup olmadığını kontrol eder (Kenan için yedekli kontrol)
    function isSuperAdmin() {
      return isApproved() && (getUserRole() == 'super_admin' || request.auth.token.email == 'kenan@inaner.com');
    }
    
    // Kullanıcının Şirket Yöneticisi olup olmadığını kontrol eder
    function isCompanyAdmin() {
      return isApproved() && (getUserRole() == 'company_admin' || getUserRole() == 'admin');
    }
    
    // Kullanıcının Admin veya Super Admin olup olmadığını kontrol eder
    function isAdmin() {
      return isSuperAdmin() || isCompanyAdmin();
    }

    // --- Kurallar ---

    // 1. Şirketler (companies)
    match /companies/{companyDoc} {
      // Herhangi bir onaylı kullanıcı şirketleri listeleyebilir/okuyabilir
      allow read: if isApproved();
      // Sadece Super Admin şirket oluşturabilir, askıya alabilir veya silebilir
      allow write: if isSuperAdmin();
    }

    // 2. Bekleyen Başvurular (pending_users)
    match /pending_users/{userId} {
      // Bir kullanıcı kendi UID'si ile başvuru oluşturabilir ve kendi başvurusunu okuyabilir
      allow create, read: if isAuthenticated() && request.auth.uid == userId;
      // Adminler tüm bekleyen başvuruları görebilir ve silebilir (onaylama/reddetme sürecinde)
      allow read, delete: if isApproved() && isAdmin();
      // Diğer durumlarda güncellenemez
      allow update: if false;
    }

    // 3. Onaylı Kullanıcılar (approved_users)
    match /approved_users/{userId} {
      // Bir kullanıcı kendi bilgilerini okuyabilir
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Aynı şirketteki onaylı kullanıcılar birbirlerini listeleyebilir (Şoför listesi vb. için)
      allow read: if isApproved() && getCompanyId() == resource.data.companyId;
      // Super Admin her kaydı oluşturabilir/güncelleyebilir/silebilir
      allow write: if isSuperAdmin();
      // Şirket Yöneticisi kendi şirketindeki kullanıcıları yönetebilir (başka bir admin veya super_admin oluşturamaz)
      allow write: if isCompanyAdmin() 
                    && (resource == null || resource.data.companyId == getCompanyId()) 
                    && (request.resource == null || request.resource.data.companyId == getCompanyId())
                    && (request.resource == null || (request.resource.data.role != 'company_admin' && request.resource.data.role != 'super_admin'));
      // Her kullanıcı kendi cihaz bildirim tokenlarını (fcmTokens) ve son görülme bilgilerini güncelleyebilir
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && (resource == null || request.resource.data.role == resource.data.role)
                    && (resource == null || request.resource.data.companyId == resource.data.companyId);
    }

    // 4. Şirket Verileri (Tüm Şirket Alt Koleksiyonları: trips, fuel, maintenance, payments, penalties, vb.)
    // Bu koleksiyonlar sadece ait oldukları şirket çalışanları tarafından erişilebilir.
    
    match /{collectionName}/{document} {
      // Şirket verisi içeren koleksiyonlar listesi
      function isCompanyDataCollection() {
        return collectionName in [
          'trips', 'fuel', 'maintenance', 'payments', 'penalties', 
          'invoices', 'payouts', 'spare_parts', 'mechanics', 'shopping_list', 
          'geofences', 'manual_splits', 'manual_merges', 'manual_deletes', 
          'custom_route_names', 'maintenance_folders', 'company_data',
          'trucks', 'vehicle_daily_stats', 'company_notifications'
        ];
      }
      
      allow read: if isApproved() && isCompanyDataCollection() && (
        isSuperAdmin() ||
        collectionName == 'company_notifications' ||
        (resource != null && resource.data.companyId == getCompanyId()) ||
        // company_data dökümanları şirket ID'si ile başlayan/biten veya info adında olabiliyor
        (collectionName == 'company_data' && (
          document == 'info' || 
          document.matches('^' + getCompanyId() + '.*') || 
          document.matches('.*' + getCompanyId() + '$')
        ))
      );
      
      allow write: if isApproved() && isCompanyDataCollection() && (
        isSuperAdmin() ||
        // Yeni veri eklerken kendi şirket ID'sini yazmak zorundadır
        (request.resource != null && request.resource.data.companyId == getCompanyId()) ||
        // company_data dökümanları için yetkilendirme
        (collectionName == 'company_data' && (
          document.matches('^' + getCompanyId() + '.*') || 
          document.matches('.*' + getCompanyId() + '$')
        ))
      );
    }

    // 5. Canlı Konum Takibi & Rotalar (live_positions, daily_routes, truck_routes)
    match /live_positions/{deviceId} {
      allow read: if isApproved();
      allow write: if isApproved() && isSuperAdmin();
    }

    match /daily_routes/{docId} {
      allow read: if isApproved();
      allow write: if isApproved() && isSuperAdmin();
    }

    match /truck_routes/{routeId} {
      allow read: if isApproved();
      allow write: if isApproved() && isSuperAdmin();
    }
    
    // 6. Sistem Logları (admin_logs)
    match /admin_logs/{logId} {
      // Logları okuma yetkisi sadece Adminlere verilir (Kendi şirketlerinin logları)
      allow read: if isApproved() && isAdmin() && (
        isSuperAdmin() || resource.data.companyId == getCompanyId()
      );
      // Log yazma yetkisi tüm onaylı kullanıcılara veya misafirlere (ziyaretçi girişi logları için) açıktır
      allow create: if true;
      // Loglar güncellenemez veya silinemez (Log bütünlüğü koruması)
      allow update, delete: if false;
    }
    
    // 7. Online Durum Takibi (presence)
    match /presence/{presenceId} {
      // Her onaylı kullanıcı online listesini okuyabilir ve kendi durumunu güncelleyebilir/silebilir
      allow read: if isApproved();
      allow write: if isAuthenticated() && (presenceId.matches('^' + request.auth.uid + '.*') || presenceId.matches('^' + getApprovedUser().username + '.*'));
    }
  }
}
