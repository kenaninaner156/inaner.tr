{
  "headers": [
    {
      "source": "/(service-worker\\.js|sw\\.js|registerSW\\.js|workbox-.*\\.js|manifest\\.json|manifest\\.webmanifest|firebase-messaging-sw\\.js|version\\.json)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api/|version\\.json|manifest\\.json|firebase-messaging-sw\\.js).*)", "destination": "/index.html" }
  ]
}
